%% velora node configuration.
%% - peers: other velora nodes to connect to (native distributed Erlang).
%% - GDAL /vsis3 credentials are read from the environment (AWS_* or
%%   AWS_S3_ENDPOINT for MinIO); set them in the node's environment, not here.
[
  {velora, [
    {http_port, 8080},
    {peers, []},               %% e.g. ['velora@10.0.0.2', 'velora@10.0.0.3']
    {tile, {512, 512}},
    {workers_per_node, undefined}

    %% Render concurrency limiter (velora_render_limiter) — caps concurrent
    %% heavy GDAL prepares (server-side warps) and sheds load past that with
    %% HTTP 503 instead of piling up GDAL subprocesses (a DoS risk on e.g. a
    %% 4 GB Pi). Defaults: 4 concurrent prepares, 5000 ms queue wait.
    %% {max_concurrent_renders, 4},
    %% {render_queue_timeout_ms, 5000},

    %% /render source-size guard (velora_web) — rejects a `prepare'/`prepare_ndvi'
    %% source whose pixel count (W*H) exceeds this many megapixels, before
    %% warping, so a caller can't point /render at an enormous raster and
    %% exhaust the box. Default: 500.
    %% {max_source_megapixels, 500},
    %% {metrics_enabled, true},          %% serve GET /metrics
    %% {ndvi_fullres, true},            %% full-res NDVI via the job engine (false = capped preview only)
    %% {ndvi_nir_band, 1}, {ndvi_red_band, 2}, %% bands for single-file NDVI

    %% Tile cache (velora_web) — a bounded in-memory cache (velora_cache, 2Q
    %% eviction) sits in front of GDAL for rendered XYZ tiles. Degrades to the
    %% on-disk `tc/' cache automatically if the velora_cache NIF isn't loaded
    %% for this platform/build.
    %% {tile_cache_entries, 2048},  %% max tiles held in memory; lower on a Pi
    %% {tile_disk_cache, false},    %% also persist tiles to tc/ as an L2 (warm
                                     %% restarts); off by default since tiles
                                     %% re-render cheaply from the local COG

    %% Prepare memoization (velora_web) — a bounded in-memory cache
    %% (velora_cache, LRU eviction) memoizes `prepare/1' by a hash of the
    %% source URI, so rendering the same source twice reuses the prepared COG
    %% instead of re-running gdalwarp/gdal_translate. A stale memo entry (its
    %% COG swept by the janitor) transparently re-warps. Degrades to the
    %% current unmemoized behavior if the velora_cache NIF isn't loaded for
    %% this platform/build.
    %% {prepare_cache_entries, 256},  %% max memoized prepared sources

    %% Emergence "eyes" — optional; unset keys disable place-based queries.
    %% {geocoder_kind, nominatim}, {geocoder_url, "https://nominatim.openstreetmap.org/search"},  %% place->imagery without the mesh
    %% {geocoder_url, "http://127.0.0.1:9211/agent/query"}, %% mesh nominatim_filter
    %% {stac_url, "https://earth-search.aws.element84.com/v1/search"},
    %% {stac_collection, <<"sentinel-2-l2a">>},
    %% {stac_cloud_cover_lt, 20},
    %% {geocode_bbox_half_deg, 0.05},
  ]},
  {kernel, [
    %% for a real cluster set a shared cookie via vm.args (-setcookie) instead.
  ]}
].
