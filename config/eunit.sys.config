%% Sys.config applied to `rebar3 eunit' runs (see rebar.config's eunit_opts).
%%
%% `workers_per_node' defaults (in config/sys.config, mirroring
%% src/velora.app.src) to the number of dirty CPU schedulers -- fine for
%% production, but oversized for the eunit suite's tiny 9-16 tile test jobs:
%% on a many-core dev box, more GDAL-spawning workers race to open the same
%% couple of test scene files than there are tiles to hand out, and the
%% resulting burst of concurrent `gdalinfo'/`gdal_translate' subprocesses
%% intermittently fails with `{gdalinfo_parse, Path}' on Windows (confirmed:
%% capping this to 4 took velora_job_manager_tests from ~15% flaky to 30/30
%% clean; the default (dirty_cpu_schedulers, uncapped) still failed ~1 run in
%% 7 even after the app-leak/teardown fixes). This is test-environment
%% over-concurrency, not a product bug, so the default itself is left alone
%% and only the eunit run is capped.
[
  {velora, [
    {workers_per_node, 4}
  ]}
].
