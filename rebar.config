{erl_opts, [debug_info, warnings_as_errors]}.

{deps, [
    {rast, "0.1.1"},
    {cowboy, "2.12.0"},
    {jsx, "3.1.0"},
    {kvex, "0.2.10"},
    {em_pop, "0.2.0"}
]}.

{shell, [{config, "config/sys.config"}, {apps, [velora]}]}.

{relx, [
    {release, {velora, "0.1.0"}, [velora, cowboy, jsx, rast, kvex, sied, sasl]},
    {sys_config, "config/sys.config"},
    {dev_mode, true},
    {include_erts, false},
    {extended_start_script, true}
]}.

{profiles, [
    {test, [{erl_opts, [nowarn_export_all]}]},
    {prod, [{relx, [{dev_mode, false}, {include_erts, true}]}]}
]}.
